# =============================================================================
# Dockerfile.build — OCR Image Builder Container
# =============================================================================
# Docker image containing all tools needed to build the OCR firmware.
#
# Usage:
#   docker build -f scripts/Dockerfile.build -t ocr-builder .
#   docker run --rm --privileged -v $(pwd):/opencr ocr-builder
#
# --privileged is required for loop device mounting during ISO creation.
# =============================================================================

FROM debian:bookworm-slim

LABEL maintainer="OpenCoreRouter <ocr@opencorerouter.dev>"
LABEL description="OCR firmware builder — OpenWrt 25.12.5 x86-64"
LABEL version="1.0.0"

# ── System packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential gcc g++ binutils make cmake ninja-build \
    # Image tools
    wget curl git unzip zstd xz-utils bzip2 gzip \
    # OpenWrt Image Builder deps
    python3 python3-pip rsync file \
    libncurses-dev libssl-dev zlib1g-dev \
    # Loop device + filesystem tools
    parted gdisk kpartx \
    e2fsprogs dosfstools mtools \
    squashfs-tools \
    # ISO creation
    xorriso grub-efi-amd64-bin grub-pc-bin isolinux \
    # VM image conversion
    qemu-utils \
    # Go (for building ocrd daemon)
    golang-1.22 \
    # Network utils
    iproute2 \
    # Misc
    jq bc ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Go binary in PATH
ENV PATH="/usr/lib/go-1.22/bin:${PATH}"

# ── Create build user (non-root for most steps) ───────────────────────────────
RUN useradd -m -s /bin/bash builder && \
    echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# ── Working directory ─────────────────────────────────────────────────────────
WORKDIR /opencr

# ── Entrypoint ───────────────────────────────────────────────────────────────
# Builds Go daemon first, then runs image builder
COPY scripts/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["--iso"]
