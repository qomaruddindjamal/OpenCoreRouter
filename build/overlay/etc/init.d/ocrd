#!/bin/sh /etc/rc.common
# Open Core Router — ocrd procd init script
# /etc/init.d/ocrd
#
# OpenWrt 25.12.5 procd service manager
# Commands: start | stop | restart | reload | status | enable | disable

START=30
STOP=85
USE_PROCD=1

PROG="/usr/sbin/ocrd"
PIDFILE="/var/run/ocrd.pid"
LOGFILE="/var/log/ocrd.log"
CONF="/etc/config/ocr"

# Read UCI config
load_config() {
	config_load ocr

	config_get LISTEN_ADDR  main listen_addr  "127.0.0.1"
	config_get LISTEN_PORT  main listen_port  "8080"
	config_get LOG_LEVEL    main log_level    "info"
	config_get ENABLED      main enabled      "1"
}

start_service() {
	load_config

	[ "$ENABLED" = "0" ] && {
		logger -t ocrd "Disabled via UCI — not starting"
		return 0
	}

	# Ensure runtime dirs exist
	mkdir -p /var/run /var/log /etc/ocr

	# Generate JWT secret if missing
	if [ ! -f /etc/ocr/jwt.secret ]; then
		logger -t ocrd "Generating JWT secret..."
		head -c 32 /dev/urandom | base64 | tr -d '\n' > /etc/ocr/jwt.secret
		chmod 600 /etc/ocr/jwt.secret
	fi

	# Wait for network stack
	local i=0
	while [ $i -lt 10 ] && ! ip link show lo &>/dev/null; do
		sleep 1; i=$((i+1))
	done

	logger -t ocrd "Starting Open Core Router daemon v1.0.1"

	procd_open_instance "ocrd"
	procd_set_param command "$PROG" \
		--listen "${LISTEN_ADDR}:${LISTEN_PORT}" \
		--log-level "$LOG_LEVEL" \
		--config "$CONF"
	procd_set_param respawn  # Auto-restart on crash
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_set_param pidfile "$PIDFILE"
	procd_set_param env \
		OCR_VERSION="1.0.1" \
		OCR_BASE_DIR="/etc/ocr" \
		OCR_JWT_SECRET_FILE="/etc/ocr/jwt.secret"
	procd_close_instance
}

stop_service() {
	logger -t ocrd "Stopping Open Core Router daemon"
}

reload_service() {
	logger -t ocrd "Reloading configuration..."
	restart
}

service_triggers() {
	# Restart ocrd when UCI ocr config changes
	procd_add_reload_trigger "ocr"
}
