# Open Core Router — Network Configuration
# /etc/config/network
#
# OpenWrt 25.12.5 UCI network config
# Managed by: netifd daemon
# OCR daemon reads/writes this via `uci` commands

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00::/48'
	option packet_steering '1'

# ── LAN bridge (default: eth0 or first NIC) ───────────────────────────────────
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option dns '8.8.8.8 8.8.4.4'

# ── WAN (default: eth1 or second NIC) ────────────────────────────────────────
config interface 'wan'
	option device 'eth1'
	option proto 'dhcp'
	option peerdns '1'
	option hostname 'opencorerouter'

config interface 'wan6'
	option device 'eth1'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'

